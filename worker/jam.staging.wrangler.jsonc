// Jam de PRUEBA (staging): el mismo Worker (jam.js) con otro nombre y sus propias salas, que además acepta los links
// temporales de TryCloudflare (los de las pruebas en el celular). La versión publicada usa jam.wrangler.jsonc, sin eso.
// Publicar: `npm run worker:jam:staging` → https://soundblue-jam-staging.<cuenta>.workers.dev
{
  "name": "soundblue-jam-staging",
  "main": "jam.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ORIGENES_PRUEBA": "^(https://[a-z0-9-]+\\.trycloudflare\\.com|http://localhost:517[0-9])$" },
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "JamRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JamRoom"] }]
}
