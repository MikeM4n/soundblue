// Configuración del Worker de Cloudflare de las Jams: un Durable Object por sala (clase SQLite, funciona en el plan
// gratis) con WebSockets con hibernación. Ver jam.js y el README («Jam»).
// Probar en el PC (local, sin cuenta de Cloudflare): `npm run worker:jam:dev` → http://localhost:8787
// Publicar (solo con el visto bueno del dueño): `npm run worker:jam:publicar` y poner su dirección en VITE_JAM_API.
{
  "name": "soundblue-jam",
  "main": "jam.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "JamRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JamRoom"] }]
}
